      ],
      "licenseRequirement": "P1",
      "needsIntentText": false,
      "profile": "baseline",
      "rationale": "Administrator accounts can change anything in the company's systems, so they are the first target for attackers. Requiring the strongest sign in proof protects the accounts with the most power.",
      "requiredState": "enabledOrReportOnly",
      "riskClass": "high",
      "sourceName": "Core - Allow - MFA for Admins",
      "surface": "conditionalAccess"
